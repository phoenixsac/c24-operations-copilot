# Copy to .env and fill in. .env is gitignored; this file is not.
#
#   cp .env.example .env
#
# Nothing here is read at import time. Config is resolved once at startup
# (app.model.config.settings) so a missing key fails loudly at boot rather than
# on the first operator question.

# ---------------------------------------------------------------------------
# Model provider — Sarvam AI
#
# MODEL_ADAPTER selects which adapter the gateway loads:
#   fake    — fixture replies, no network. Default. What the eval suite runs
#             against (docs/INVARIANTS.md C6).
#   sarvam  — the real provider.
#
# Leaving the default as `fake` is deliberate: a fresh clone with no API key
# must still boot, still serve the console, and still pass evals.
# ---------------------------------------------------------------------------
MODEL_ADAPTER=fake

SARVAM_API_KEY=
SARVAM_BASE_URL=https://api.sarvam.ai/v1
SARVAM_MODEL=sarvam-105b

# Per-call ceilings. Budgets, not suggestions — docs/INVARIANTS.md D5.
# sarvam-105b is a reasoning model and max_tokens covers its thinking too. Below
# ~4096 it burns the whole budget reasoning and returns empty content, so the
# adapter enforces a 4096 floor regardless of what is set here.
MODEL_TIMEOUT_S=60
MODEL_MAX_TOKENS=4096
MODEL_MAX_RETRIES=1

# Determinism. VERIFIED NOT HONOURED: two identical requests at temperature=0
# with a fixed seed returned different classifications. Both are still sent —
# they cost nothing — but C1/C2 are enforced above the model, by caching the IR
# per (query, scope), not by trusting the decoder. docs/IMPL.md §10.
MODEL_TEMPERATURE=0
MODEL_SEED=17

# ---------------------------------------------------------------------------
# Database — Postgres, not SQLite. There is no DB_PATH: the schema depends on
# row-level security, and RLS has no SQLite equivalent (docs/DESIGN.md §9).
#
# These defaults target the docker-compose `db` service. Override the host to
# `localhost` when running the API outside compose.
# ---------------------------------------------------------------------------
DATABASE_URL=postgres://app_user:app_user@localhost:55432/copilot
READONLY_DATABASE_URL=postgres://app_readonly:app_readonly@localhost:55432/copilot

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# Demo affordance only — the actor used when no X-Actor-Id header is sent.
# Naming a different actor cannot widen scope; the server looks scope up from
# the app_actor row. docs/INVARIANTS.md E3.
DEFAULT_ACTOR=u_priya

# Host port mappings for docker compose.
POSTGRES_PORT=5432
API_PORT=8000
UI_PORT=5173

# ---------------------------------------------------------------------------
# The demo clock. Must match `t0` in db/init/03_seed.sql.
#
# The seed pins a fixed moment so re-seeding is byte-identical (C7). Rule
# evaluation has to read the same moment, or the dataset ages out from under
# the rules: a ticket seeded "20 minutes old" becomes 26 hours old overnight,
# `ticket_first_response_breach` fires on rows that were clean, and evals that
# passed yesterday fail today with nothing changed. That happened.
#
# Unset this in production and everything uses real wall-clock time.
# ---------------------------------------------------------------------------
APP_CLOCK=2026-09-10T12:00:00+05:30

# ---------------------------------------------------------------------------
# Tracing — Langfuse, self-hosted. Optional and inert without keys.
#
# SELF-HOSTED ONLY. A trace carries the operator's question and resolved entity
# ids; pointing LANGFUSE_HOST at their cloud sends those to a third party,
# which is the boundary INVARIANTS.md §H describes. Run it locally:
#
#   git clone https://github.com/langfuse/langfuse.git ../langfuse
#   cd ../langfuse && docker compose up -d      # UI on :3000, ~2-3 min to boot
#
# Then create a project in the UI and paste its keys here.
# ---------------------------------------------------------------------------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://host.docker.internal:3000
